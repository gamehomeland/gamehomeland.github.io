  "checks": [
    {
      "id": "category-capacity",
      "kind": "dynamic",
      "source": ["HLBOp_Check.CheckAdd", "HLBView_ErrorItemList.UpdateErrorItemOverflow"],
      "rule": "GetLevelFurnitureConfig(category1,category2,level).LimCount compared with current plus added count"
    },
    {
      "id": "per-item-capacity",
      "kind": "dynamic",
      "source": ["HLBOp_Check.CheckAdd"],
      "rule": "GetFurnitureConfig(id).nMaxAmountPerLand; PENDANT branch uses 1; available stock checked separately"
    },
    {
      "id": "storage-usage",
      "kind": "observed-native-threshold",
      "module": "JX3LogicEditOperationX64.dll",
      "lua_rva": "0x3a8e70",
      "check_rva": "0x431ae0",
      "query_rva": "0x3a8f70",
      "cost_rva": "0x42da10",
      "accumulate_rva": "0x42ffe0",
      "threshold": 7936,
      "reject_comparator": ">=",
      "unit": "model-specific storage cost, not furniture count"
    },
    {
      "id": "land-object-usage",
      "kind": "observed-native-threshold",
      "module": "JX3LogicEditOperationX64.dll",
      "lua_rva": "0x3a8ef0",
      "check_rva": "0x431ac0",
      "query_rva": "0x3a9010",
      "cost_rva": "0x42da50",
      "accumulate_rva": "0x42ffe0",
      "threshold": 12288,
      "reject_comparator": ">=",
      "unit": "model-specific object cost, not furniture count"
    },
    {
      "id": "sdk-save-size",
      "kind": "observed-native-threshold",
      "module": "JX3LogicEditOperationX64.dll",
      "query_rva": "0x293370",
      "upload_rva": "0x290e90",
      "source": ["HLBView_Saveusage.UpdateLimitationProgress"],
      "ordinary_bytes": 3145728,
      "private_branch_bytes": 6291456,
      "uncompressed_reject_comparator": ">=",
      "encoded_overhead": 1000,
      "encoded_reject_comparator": ">",
      "encoded_limit": "runtime configuration field; no universal constant asserted",
      "scope": "game save/upload data, not ZIP or blueprintx size"
    },
    {
      "id": "global-scene-size",
      "kind": "scene-dependent",
      "module": "JX3RepresentX64.dll",
      "prepare_rva": "0x8c5270",
      "load_rva": "0x8b8e70",
      "rule": "global scene dimensions compared with current scene; not a universal local component size"
    },
    {
      "id": "scale-and-height",
      "kind": "per-resource",
      "source": [
        "HLBView_ItemOpScale.Update",
        "HLBView_ItemOpHeight.Update",
        "Homeland_FurnitureInfo.tab"
      ],
      "rule": "szScaleRange and szHeightLimit; empty height range does not prove unlimited placement"
    },
    {
      "id": "editing-state",
      "kind": "state-dependent",
      "source": [
        "HLBOp_Check.Check",
        "HLBOp_Check.CheckSave",
        "HLBOp_Check.CheckAutoSave",
        "HLBOp_Blueprint.StartLoadBlueprint"
      ],
      "rule": "unfinished editing operations and furniture error list can block save"
    },
    {
      "id": "child-count-field",
      "kind": "format-width",
      "module": "JX3RepresentX64.dll",
      "save_rva": "0x8e4960",
      "load_rva": "0x8dd820",
      "bits": 16,
      "scope": "field capacity, not placement capacity"
    },
    {
      "id": "cloth-scale",
      "kind": "verified-resource-data",
      "variants": 144,
      "sizes_m": [2.0, 4.0],
      "min_scale": 0.25,
      "max_scale": 2,
      "source": "data/furniture_palette.json"
    }
  ],
  "unconfirmed": [
    "universal total furniture count",
    "all plot dimensions",
    "complete server-side rules",
    "universal attachment limit"
  ]
}
